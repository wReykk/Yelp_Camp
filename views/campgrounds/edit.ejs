<% layout('layouts/boilerplate') %>
    <link rel="stylesheet" href="/stylesheets/createandedit.css">

    <div class="create-campground-container">
        <h1 class="create-page-title">Edit Campground</h1>

        <form action="/campgrounds/<%= camps._id %>?_method=PUT" method="POST" class="validated-form" novalidate
            enctype="multipart/form-data" id="editForm">

            <div class="create-card-wrapper">

                <div class="form-section">
                    <div class="form-group">
                        <label for="title" class="form-label">Campground Name</label>
                        <input type="text" name="campground[title]" id="title" class="form-control"
                            placeholder="Enter campground name" value="<%= camps.title %>" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="campground[location]" id="location" class="form-control"
                            placeholder="Enter location" value="<%= camps.location %>" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="price" class="form-label">Price Per Night</label>
                        <div class="price-input-group">
                            <span class="price-currency">$</span>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" id="price"
                                name="campground[price]" value="<%= camps.price %>" required>
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="campground[description]" id="description" class="form-control"
                            placeholder="Describe your campground..." rows="5"
                            required><%= camps.description %></textarea>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="image" class="form-label">Upload New Photos</label>
                        <input class="form-control file-input" type="file" id="image" name="image" multiple
                            accept="image/*">
                        <small class="form-text">You can select multiple new photos to upload</small>
                    </div>

                    <div class="form-actions" style="margin-top: 2rem;">
                        <button type="submit" class="btn-submit">Update Campground</button>
                        <a href="/campgrounds/<%= camps._id %>" class="btn-cancel">Cancel</a>
                    </div>
                </div>

                <div class="image-preview-section">
                    <div class="preview-header">
                        <h3>Campground Photos</h3>
                    </div>

                    <div class="image-preview-grid" id="imagePreviewGrid">

                        <% if(camps.images.length===0) { %>
                            <div class="preview-placeholder" id="emptyPlaceholder">
                                <span class="placeholder-icon">📷</span>
                                <p>No photos yet. Select photos to upload.</p>
                            </div>
                            <% } %>

                                <% camps.images.forEach((img, i)=> { %>
                                    <div class="image-preview-item existing-photo">
                                        <img src="<%= img.thumbnail %>" alt="Existing photo" id="img-preview-<%= i %>">

                                        <input type="checkbox" id="image-<%= i %>" name="deleteImages[]"
                                            value="<%= img.filename %>" style="display: none;">

                                        <label for="image-<%= i %>" class="remove-image toggle-delete"
                                            data-target="img-preview-<%= i %>" title="Mark for deletion">
                                            ✕
                                        </label>
                                    </div>
                                    <% }) %>

                    </div>
                </div>

            </div>
        </form>
    </div>

    <script>
        const imageInput = document.getElementById('image');
        const previewGrid = document.getElementById('imagePreviewGrid');
        const placeholder = document.getElementById('emptyPlaceholder');
        imageInput.addEventListener('change', function (e) {

            const newPreviews = document.querySelectorAll('.new-photo-preview');
            newPreviews.forEach(item => item.remove());

            const files = e.target.files;

            const existingPhotosCount = document.querySelectorAll('.existing-photo').length;
            if (placeholder) {
                if (files.length > 0 || existingPhotosCount > 0) {
                    placeholder.style.display = 'none';
                } else {
                    placeholder.style.display = 'flex';
                }
            }

            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const imgContainer = document.createElement('div');
                    imgContainer.className = 'image-preview-item new-photo-preview';
                    imgContainer.innerHTML = `
                    <img src="${event.target.result}" alt="New Preview" style="border: 3px solid #5fb586;">
                `;
                    previewGrid.appendChild(imgContainer);
                };
                reader.readAsDataURL(file);
            });
        });

        const deleteButtons = document.querySelectorAll('.toggle-delete');
        deleteButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const imgId = this.getAttribute('data-target');
                const imgElement = document.getElementById(imgId);

                const checkbox = document.getElementById(this.getAttribute('for'));

                setTimeout(() => {
                    if (checkbox.checked) {
                        imgElement.style.opacity = '0.3';
                        imgElement.style.filter = 'grayscale(100%)';
                        this.style.opacity = '1';
                        this.style.background = 'rgba(220, 53, 69, 1)';
                        this.innerHTML = '↺';
                    } else {
                        imgElement.style.opacity = '1';
                        imgElement.style.filter = 'none';
                        this.style.opacity = '';
                        this.style.background = '';
                        this.innerHTML = '✕';
                    }
                }, 10);
            });
        });
    </script>