<% layout('layouts/boilerplate') %>
    <link rel="stylesheet" href="/stylesheets/createandedit.css">

    <div class="create-campground-container">
        <h1 class="create-page-title">Create New Campground</h1>

        <div class="create-card-wrapper">
            <!-- Left: Form -->
            <div class="form-section">
                <form action="/campgrounds" method="POST" class="validated-form" novalidate
                    enctype="multipart/form-data" id="createForm">

                    <div class="form-group">
                        <label for="title" class="form-label">Campground Name</label>
                        <input type="text" name="campground[title]" id="title" class="form-control"
                            placeholder="Enter campground name" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="location" class="form-label">Location</label>
                        <input type="text" name="campground[location]" id="location" class="form-control"
                            placeholder="Enter location" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="price" class="form-label">Price Per Night</label>
                        <div class="price-input-group">
                            <span class="price-currency">$</span>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" id="price"
                                name="campground[price]" required>
                        </div>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="campground[description]" id="description" class="form-control"
                            placeholder="Describe your campground..." rows="5" required></textarea>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="form-group">
                        <label for="image" class="form-label">Upload Photos</label>
                        <input class="form-control file-input" type="file" id="image" name="image" multiple
                            accept="image/*">
                        <small class="form-text">You can select multiple photos</small>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-submit">Create Campground</button>
                        <a href="/campgrounds" class="btn-cancel">Cancel</a>
                    </div>
                </form>
            </div>

            <!-- Right: Image Preview -->
            <div class="image-preview-section">
                <div class="preview-header">
                    <h3>Photo Preview</h3>
                    <span class="image-count" id="imageCount">0 photos</span>
                </div>
                <div class="image-preview-grid" id="imagePreviewGrid">
                    <div class="preview-placeholder">
                        <span class="placeholder-icon">📷</span>
                        <p>Select photos to preview them here</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const imageInput = document.getElementById('image');
        const previewGrid = document.getElementById('imagePreviewGrid');
        const imageCount = document.getElementById('imageCount');

        imageInput.addEventListener('change', function (e) {
            previewGrid.innerHTML = '';
            const files = e.target.files;
            const count = files.length;

            imageCount.textContent = count + (count === 1 ? ' photo' : ' photos');

            if (count === 0) {
                previewGrid.innerHTML = `
                    <div class="preview-placeholder">
                        <span class="placeholder-icon">📷</span>
                        <p>Select photos to preview them here</p>
                    </div>
                `;
                return;
            }

            Array.from(files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function (event) {
                    const imgContainer = document.createElement('div');
                    imgContainer.className = 'image-preview-item';
                    imgContainer.innerHTML = `
                        <img src="${event.target.result}" alt="Preview ${index + 1}">
                        <button type="button" class="remove-image" data-index="${index}">✕</button>
                    `;
                    previewGrid.appendChild(imgContainer);
                };
                reader.readAsDataURL(file);
            });
        });
    </script>