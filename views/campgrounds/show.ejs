<% layout('layouts/boilerplate')%>
    <link rel="stylesheet" href="/stylesheets/stars.css">
    <link rel="stylesheet" href="/stylesheets/show.css">

    <!-- Main Campground Details Section -->
    <div class="campground-details-section">
        <!-- Left: Campground Info (1/3) -->
        <div class="campground-info">
            <div class="info-title-container">
                <h1 class="info-title">
                    <%= camps.title%>
                </h1>
                <div class="info-author">
                    By <strong>
                        <%= camps.author.username%>
                    </strong>
                </div>
            </div>

            <div class="info-item">
                <div class="info-label">Location</div>
                <div class="info-value">
                    <%= camps.location%>
                </div>
            </div>

            <div class="info-item">
                <div class="info-label">Price per night</div>
                <div class="info-value" style="font-size: 1.5rem; color: #5fb586;">$<%= camps.price%>
                </div>
            </div>

            <div class="info-item">
                <div class="info-label">Rating</div>
                <% const rating=Math.round(camps.averageRating * 2) / 2; const fullStars=Math.floor(rating); const
                    hasHalf=(rating % 1)>= 0.5;
                    const emptyStars = 5 - fullStars - (hasHalf ? 1 : 0);
                    const displayRating = Math.round(rating);
                    %>
                    <div class="rating-display">
                        <%= '★' .repeat(fullStars) %>
                            <!-- <% if(hasHalf) { %>◑<% } %> -->
                            <%= '☆' .repeat(emptyStars) %>

                                <a href="#comments-section" class="review-count">
                                    (<%= camps.reviews.length %> review<%= camps.reviews.length !==1 ? 's' : '' %>)
                                </a>
                    </div>
            </div>

            <div class="info-item">
                <div class="info-label">Description</div>
                <p class="description">
                    <%= camps.description%>
                </p>
            </div>

            <% if(currentUser && camps.author && camps.author.equals(currentUser._id)) { %>
                <div class="action-buttons">
                    <a class="action-btn edit-btn" href="/campgrounds/<%=camps._id%>/edit">
                        <span class="btn-text">Edit</span>
                    </a>
                    <form class="action-form" action="/campgrounds/<%=camps._id%>?_method=DELETE" method="POST">
                        <button type="submit" class="action-btn delete-btn">
                            <span class="btn-text">Delete</span>
                        </button>
                    </form>
                </div>
                <% } %>
        </div>

        <!-- Right: Carousel & Map (2/3) -->
        <div class="campground-images">
            <div class="carousel-container">
                <div id="CampgroundCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <% camps.images.forEach((img, i)=> { %>
                            <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                                <img class="d-block w-100 carousel-images" src="<%= img.url %>" alt="">
                            </div>
                            <% }) %>
                    </div>
                    <% if(camps.images.length> 1) { %>
                        <a class="carousel-control-prev" href="#CampgroundCarousel" role="button" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon aria-hidden=" true"></span>
                        </a>
                        <a class="carousel-control-next" href="#CampgroundCarousel" role="button" data-bs-slide="next">
                            <span class="carousel-control-next-icon aria-hidden=" true"></span>
                        </a>
                        <% } %>
                </div>

                <!-- Map in bottom right corner -->
                <div class="map-container" id="map"></div>
            </div>
        </div>
    </div>

    <!-- Comments Section -->
    <div class="comments-section" id="comments-section">
        <h2 class="comments-heading">Comments & Reviews</h2>

        <% if (currentUser) { %>
            <div class="review-form-container">
                <h3 class="review-form-heading">Leave a Review</h3>
                <form action="/campgrounds/<%= camps._id %>/reviews" method="POST" class="validated-form" novalidate>
                    <div class="mb-3">
                        <fieldset class="starability-basic">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="3"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="body">Your Review</label>
                        <textarea class="form-control" name="review[body]" id="body" required></textarea>
                        <div class="valid-feedback">
                            Looks Good!
                        </div>
                    </div>
                    <button class="btn btn-success">Submit Review</button>
                </form>
            </div>
            <% } %>

                <% if(camps.reviews.length> 0) { %>
                    <div>
                        <% for(let review of camps.reviews) {%>
                            <div class="review-card">
                                <p class="starability-result" data-rating="<%= review.rating %>">
                                    ⭐ <%= review.rating %> / 5 stars
                                </p>
                                <h6 class="review-author">
                                    <%= review.author ? review.author.username : 'Anonymous' %>
                                </h6>
                                <p class="review-body">
                                    <%= review.body %>
                                </p>
                                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                    <form
                                        action="/campgrounds/<%= camps._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        method="POST" class="mt-2">
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                    <% } %>
                            </div>
                            <% } %>
                    </div>
                    <% } else { %>
                        <p style="color: #888; text-align: center; padding: 2rem;">No reviews yet. Be the first to leave
                            a review!</p>
                        <% } %>

                            <div class="go-back-button">
                                <a href="#"
                                    onclick="document.querySelector('.campground-details-section').scrollIntoView({ behavior: 'smooth' }); return false;">↑
                                    Go Back to Top</a>
                            </div>
    </div>

    <script type="application/json" id="campground-data">
    <%- JSON.stringify(camps) %>
</script>

    <script>
        const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
        const campground = JSON.parse(document.getElementById('campground-data').textContent);
    </script>

    <script src="/js/showPageMap.js"></script>