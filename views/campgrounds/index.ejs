<% layout('layouts/boilerplate') %>

    <div id="map" class="full-width-container map-offset" style="height: 500px;"></div>

    <h1 class="text-center campgrounds-heading mb-5">All Campgrounds</h1>

    <div class="full-width-container">

        <div class="row row-cols-1 row-cols-md-3 g-4 px-4 mx-0 mb-5">
            <% for(let camp of camps) { %>
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 campground-card">

                        <% if(camp.images && camp.images.length) { %>
                            <img src="<%= camp.images[0].url %>" class="card-img-top" alt="<%= camp.title %>"
                                style="height: 300px; object-fit: cover;">
                            <% } else { %>
                                <img src="https://images.unsplash.com/photo-1478131143081-80f7f84ca84d?w=800&h=300&fit=crop"
                                    class="card-img-top" alt="default camp" style="height: 300px; object-fit: cover;">
                                <% } %>

                                    <div class="card-body">
                                        <h5 class="card-title mb-3">
                                            <a href="/campgrounds/<%= camp._id %>"
                                                class="text-decoration-none campground-title-link">
                                                <b>
                                                    <%= camp.title %>
                                                </b>
                                            </a>
                                        </h5>
                                        <h6 class="text-muted"><b>location:</b>
                                            <%= camp.location %>
                                        </h6>
                                        <h6><b>price:</b> <span class="text-success">
                                                <%= camp.price %>$
                                            </span> per night</h6>
                                        <p class="card-text mt-3">
                                            <%= camp.description %>
                                        </p>
                                    </div>
                    </div>
                </div>
                <% } %>
        </div>
    </div>

    <%- "<script>" %>
        const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
            const camps = {
            type: "FeatureCollection",
            features: <%- JSON.stringify( camps.map(camp=> ({
                type: "Feature",
                geometry: camp.geometry,
                properties: { popUpMarkup: camp?.properties?.popUpMarkup }
                }))) %>
                };
                <%- "</script>" %>

                    <script src="/js/clusterMap.js"></script>