<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YelpCamp</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/css/bootstrap.min.css"
        integrity="sha384-r4NyP46KrjDleawBgD5tp8Y7UzmLA05oM1iAEQ17CSuDqnUK2+k9luXQOfXJCJ4I" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/home.css">

</head>

<body class="d-flex text-center text-white vh-100 flex-column">
    <div
        class="cover-container d-flex w-100 p-3 mx-auto flex-column align-items-center justify-content-center flex-grow-1">
        <main class="px-3 main-content-wrapper w-100">
            <h1 class="font-weight-bold mb-4" id="yelp-camp">YelpCamp</h1>

            <p class="lead mb-5 hero-text">
                Welcome to YelpCamp! <br>
                Jump right in and explore our many campgrounds. <br>
                Feel free to share some of your own and comment on others!
            </p>

            <div class="container-fluid px-0">
                <div class="row g-3 justify-content-center">

                    <div class="col-12 mb-2">
                        <a href="/campgrounds"
                            class="btn btn-light font-weight-bold text-dark px-4 py-3 shadow w-100 custom-btn-pill">
                            View Campgrounds
                        </a>
                    </div>

                    <div class="col-6">
                        <a href="/login" class="btn btn-light text-dark py-2 shadow w-100 custom-btn-pill">
                            Sign In
                        </a>
                    </div>
                    <div class="col-6">
                        <a href="/register" class="btn btn-light text-dark py-2 shadow w-100 custom-btn-pill">
                            Sign Up
                        </a>
                    </div>

                </div>
            </div>
        </main>
    </div>

    <footer class="mt-auto text-white-50 pb-3">
        <p>&copy; 2026 YelpCamp</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
        integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
        crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/js/bootstrap.min.js"
        integrity="sha384-oesi62hOLfzrys4LxRF63OJCXdXDipiYWBnvTl9Y9/TRlw5xlKIEHpNyvvDShgf/"
        crossorigin="anonymous"></script>
</body>

</html>