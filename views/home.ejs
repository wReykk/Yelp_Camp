    <div
        class="cover-container d-flex w-100 p-3 mx-auto flex-column align-items-center justify-content-center flex-grow-1">
        <main class="px-3">
            <h1 class="display-2 font-weight-bold mb-4" id="yelp-camp">YelpCamp</h1>
            <p class="lead mb-5" style="font-size: 1.5rem;">
                Welcome to YelpCamp! <br>
                Jump right in and explore our many campgrounds. <br>
                Feel free to share some of your own and comment on others!
            </p>
            <a href="/campgrounds" class="btn btn-light font-weight-bold text-dark px-5 py-3 shadow col-9 mb-5"
                style="font-size: 1.25rem; border-radius: 50px;">
                View Campgrounds
            </a>
            <a href="/login" class="btn btn-light text-dark px-4 py-2 shadow col-3 mr-3"
                style="font-size: 1.25rem; border-radius: 50px;">
                Sign In
            </a>
            <a href="/register" class="btn btn-light text-dark px-4 py-2 shadow col-3"
                style="font-size: 1.25rem; border-radius: 50px;">
                Sign Up
            </a>
        </main>
    </div>

    <footer class="mt-auto text-white-50 pb-3">
        <p>&copy; 2026 YelpCamp</p>
    </footer>

